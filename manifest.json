{
  "manifest_version": 3,
  "name": "Word Meaning Assistant by Guilherme Sant' Anna",
  "version": "1.0.1",
  "description": "Shows meaning and examples when double-clicking a word",
  "permissions": [],
  "host_permissions": ["https://api.dictionaryapi.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
  "16": "icons/icon_16.png",
  "32": "icons/icon_32.png",
  "48": "icons/icon_48.png",
  "128": "icons/icon_128.png"
},
"action": {
  "default_icon": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "default_title": "Word Meaning Assistant"
}
}